Bootstrap: docker
From: ubuntu:22.04

%environment
    export PATH="/opt/paws/.venv/bin:/root/.local/bin:$PATH"
    export VIRTUAL_ENV="/opt/paws/.venv"

%post
    # base os
    apt-get update -y
    apt-get install -y build-essential curl git python3 python3-dev

    # install uv
    curl -LsSf https://astral.sh/uv/install.sh | sh

    # clone repo and install with locked dependencies
    git clone https://github.com/damondmc/paws /opt/paws
    cd /opt/paws && /root/.local/bin/uv sync --frozen
