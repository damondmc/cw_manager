Bootstrap: docker
From: ubuntu:22.04

%environment
    export PATH="/opt/paws/.venv/bin:$PATH"
    export VIRTUAL_ENV="/opt/paws/.venv"

%post
    # 1. Minimize apt overhead during install
    apt-get update -y
    apt-get install -y --no-install-recommends build-essential curl git python3 python3-dev

    # 2. Install uv
    curl -LsSf https://astral.sh/uv/install.sh | sh

    # 3. Clone and sync with the --no-cache flag to prevent wheel duplication
    git clone https://github.com/damondmc/paws /opt/paws
    cd /opt/paws
    /root/.local/bin/uv sync --frozen --no-dev --no-editable --compile-bytecode --no-cache

    # 4. HOUSEKEEPING: Strip out all the extra weight
    rm -rf /opt/paws/.git          # Remove git history
    rm -rf /root/.local/bin/uv     # Remove the uv installer binary
    apt-get clean                  # Clear local repository of retrieved package files
    rm -rf /var/lib/apt/lists/* # Wipe out the apt index lists map
